# ------------------------------------------------------------------
# Central de Comando - APP CENTRAL (SSO / IAM)
# Copie para .env e ajuste. Nunca versione o .env real.
# ------------------------------------------------------------------

# --- Aplicação ---
APP_NAME=Central de Comando
APP_ENV=dev
DEBUG=true
# URL pública base do APP CENTRAL (usada em redirects OIDC)
BASE_URL=http://localhost:8000
# Chave para assinar o cookie de sessão da UI web (troque em produção)
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-bem-grande
# Segundos de duração da sessão web
SESSION_MAX_AGE=43200

# --- Banco (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=central_comando
DB_USER=central
DB_PASSWORD=central
DB_ROOT_PASSWORD=root
# Cria as tabelas no startup se não existirem (dev). Em produção use Alembic.
AUTO_CREATE_TABLES=true

# --- JWT (tokens emitidos pelo APP CENTRAL como provedor OIDC) ---
# Chaves RSA para assinar os tokens. Se vazio, é gerado em ./keys no 1º boot.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=120

# --- Federação gov.br (login único) ---
# Homologação: https://sso.staging.acesso.gov.br
# Produção:    https://sso.acesso.gov.br
GOVBR_ENABLED=false
GOVBR_ISSUER=https://sso.staging.acesso.gov.br
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:8000/auth/govbr/callback
GOVBR_SCOPES=openid email profile
# Cria automaticamente um operador quando alguém loga via gov.br sem cadastro
GOVBR_AUTO_PROVISION=true
# Operador provisionado já entra ativo? (false = precisa liberação de um admin)
GOVBR_PROVISION_ACTIVE=false

# --- Login Único municipal (Neomind Fusion - WSAuthInit/WSAuthVerify) ---
# Fluxo próprio da prefeitura (NÃO é OIDC). 3 passos: init -> redirect -> verify.
# Cada câmara pode ter a própria instância: em Clientes, preencha
# "loginunico_base_url" no cadastro para sobrescrever o valor global abaixo.
LOGINUNICO_ENABLED=false
LOGINUNICO_BASE_URL=https://loginunico.cabofrio.rj.gov.br/loginunico
LOGINUNICO_SYS=SLU
LOGINUNICO_CALLBACK_URL=http://localhost:8000/auth/loginunico/callback
LOGINUNICO_AUTO_PROVISION=true
LOGINUNICO_PROVISION_ACTIVE=false
# Nível mínimo da conta exigido para entrar (1, 2 ou 3)
LOGINUNICO_MIN_LEVEL=1
LOGINUNICO_VERIFY_SSL=true
LOGINUNICO_TIMEOUT=15

# --- SSO Microsoft (Entra ID / Azure AD) ---
# Authorization Code sem lib. Só autentica operador JÁ cadastrado (casa por e-mail),
# não cria usuário novo. Deixe vazio para esconder o botão "Entrar com Microsoft".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# DEVE bater EXATO com o redirect cadastrado no App Registration (https:// incluso).
# NUNCA montar a partir do host da request.
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_SCOPES=openid profile email User.Read
MICROSOFT_TIMEOUT=15

# --- Bootstrap do primeiro administrador (usado por scripts/seed.py) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=admin123
