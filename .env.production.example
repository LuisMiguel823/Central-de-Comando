# ------------------------------------------------------------------
# Central de Comando - APP CENTRAL (SSO / IAM) — PRODUÇÃO
#
# Se estiver subindo via Portainer ("stack from repository"): NÃO cria esse
# arquivo no servidor — cola essas variáveis (preenchidas com valor real) no
# painel "Environment variables" da stack, dentro do Portainer. O compose
# lê de lá, não de um arquivo.
#
# Se estiver subindo via linha de comando (docker compose --env-file): aí
# sim, copie para .env.production ao lado do docker-compose.prod.yml no
# servidor e preencha os valores reais. NUNCA commitar esse arquivo real —
# só este exemplo.
# ------------------------------------------------------------------

# --- Aplicação ---
APP_NAME=Central de Comando
APP_ENV=production
DEBUG=false
# Domínio público real (sem barra no final) — usado nos redirects OIDC que
# os sistemas satélite vão receber. Trocar depois muda o "issuer" pra quem
# já integrou, então definir antes de cadastrar o primeiro sistema satélite.
BASE_URL=https://central.npibrasil.com
# OBRIGATÓRIO trocar — gere uma string aleatória grande (ex.: openssl rand -hex 32).
# Nunca reaproveitar a SECRET_KEY de dev.
SECRET_KEY=
SESSION_MAX_AGE=43200

# --- Banco (MySQL) ---
# DB_HOST e DB_PORT são sobrescritos pelo docker-compose.prod.yml (aponta pro
# container "db" da rede interna) — os valores abaixo só importam se rodar
# fora do compose. DB_NAME/USER/PASSWORD/ROOT_PASSWORD são os que valem.
DB_HOST=db
DB_PORT=3306
DB_NAME=central_comando
DB_USER=central
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Produção usa Alembic (migration já versionada no repo), NUNCA autocreate.
AUTO_CREATE_TABLES=false

# --- JWT (tokens emitidos pelo APP CENTRAL como provedor OIDC) ---
# Se vazio, é gerado em ./keys no 1º boot — mas em produção, se o container
# for recriado sem volume persistente pra ./keys, os tokens emitidos antes
# ficam inválidos. Ideal: gerar uma vez e manter fixo (ou montar volume).
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=120

# --- Federação gov.br (login único) ---
GOVBR_ENABLED=false
GOVBR_ISSUER=https://sso.acesso.gov.br
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=https://central.npibrasil.com/auth/govbr/callback
GOVBR_SCOPES=openid email profile
GOVBR_AUTO_PROVISION=true
GOVBR_PROVISION_ACTIVE=false

# --- Login Único municipal (Neomind Fusion) ---
LOGINUNICO_ENABLED=false
LOGINUNICO_BASE_URL=https://loginunico.cabofrio.rj.gov.br/loginunico
LOGINUNICO_SYS=SLU
LOGINUNICO_CALLBACK_URL=https://central.npibrasil.com/auth/loginunico/callback
LOGINUNICO_AUTO_PROVISION=true
LOGINUNICO_PROVISION_ACTIVE=false
LOGINUNICO_MIN_LEVEL=1
LOGINUNICO_VERIFY_SSL=true
LOGINUNICO_TIMEOUT=15

# --- SSO Microsoft (Entra ID / Azure AD) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://central.npibrasil.com/auth/microsoft/callback
MICROSOFT_SCOPES=openid profile email User.Read
MICROSOFT_TIMEOUT=15

# --- Bootstrap do primeiro administrador ---
# Aplicado automaticamente no primeiro boot (só se o banco ainda não tiver
# nenhum usuário — scripts/seed.py --if-empty --admin-only, via CMD do Dockerfile).
# TROQUE a senha assim que conseguir logar pela primeira vez.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@npibrasil.com
BOOTSTRAP_ADMIN_PASSWORD=
